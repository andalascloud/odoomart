# Odoo 20 Community & Local Payment Gateway Configuration
# Configure secrets via the Secrets panel in AI Studio.
# Do NOT commit actual credentials to version control.

# Odoo 20 Community Server URL (e.g., https://erp.tokoanda.co.id)
ODOO_BASE_URL=https://odoo.example.com

# Odoo Database Name
ODOO_DB=odoo20_community

# Odoo API Key (User Settings -> Account Security -> API Keys in Odoo 20)
ODOO_API_KEY=YOUR_ODOO_API_KEY

# Local Payment Gateway (Midtrans Core/Snap API or compatible Indonesian gateway)
PAYMENT_GATEWAY_BASE_URL=https://api.sandbox.midtrans.com
PAYMENT_GATEWAY_SERVER_KEY=YOUR_PAYMENT_GATEWAY_SERVER_KEY
PAYMENT_GATEWAY_CLIENT_KEY=YOUR_PAYMENT_GATEWAY_CLIENT_KEY
